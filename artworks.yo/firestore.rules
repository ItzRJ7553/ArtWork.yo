rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if request is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper to check if admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ronitjain8080@gmail.com'
      );
    }
    
    // Artworks collection
    match /artworks/{artworkId} {
      allow read: if true;
      allow create: if true; // Allow sellers to publish
      allow update, delete: if true; // Allow creators and admin moderation
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Purchases & Certificates
    match /purchases/{purchaseId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Saved artworks bookmarks
    match /saved/{saveId} {
      allow read, write: if true;
    }
    
    // Chats and messages between buyers and artists
    match /chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}

